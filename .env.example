# Se copia este archivo como .env y se cambian los valores (el .env real NO se sube a GitHub).

# Clave secreta de la sesión web y de los tokens JWT (se genera con: flask --app app key:generate)
SECRET_KEY=

# Conexión a MySQL (XAMPP: usuario root sin contraseña; la base de datos debe existir)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dropx
# Solo para servicios en la nube que exigen SSL (ej: Aiven): ruta del certificado .pem
DB_SSL_CA=

# Horas de duración del token de la API (168 = 7 días)
JWT_EXPIRES_HOURS=168

# Número de WhatsApp del asesor para el formulario de contacto, con indicativo y sin "+" (ej: 573001234567)
WHATSAPP_ADVISOR_NUMBER=

# Nombres y contraseñas de los usuarios que crea "flask --app app db:seed"
SEED_ADMIN_NAME="Admin Fullname"
SEED_ADMIN_PASSWORD=cambia-esta-clave
SEED_MANAGER_NAME="Manager Fullname"
SEED_MANAGER_PASSWORD=cambia-esta-clave
SEED_COURIER_NAME="Courier Fullname"
SEED_COURIER_PASSWORD=cambia-esta-clave
